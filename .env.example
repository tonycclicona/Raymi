# =============================================================================
# UNU RAYMI - ENVIRONMENT VARIABLES (HOSTINGER WEB BUSINESS & PRODUCTION)
# =============================================================================
# You can set these in Hostinger via:
# 1. A .env file in public_html/ or domains/api.unu-raymi.com/public_html/
# 2. Or in .htaccess using: SetEnv DB_DRIVER mysql
# 3. Or in GitHub Secrets for CI/CD deployment
# =============================================================================

# Database Driver: 'json' (instant, zero-config file mode) or 'mysql' (Hostinger MySQL)
DB_DRIVER=json

# Hostinger MySQL Database Settings (Required only if DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u209525223_unuraymi
DB_USER=u209525223_admin
DB_PASS=YourStrongHostingerPasswordHere

# Custom Data Directory (Optional - default is auto-detected)
# DATA_PATH=/home/u209525223/domains/api.unu-raymi.com/public_html/database/data

# Administrative Portal Credentials (admin login at /admin/login.php)
ADMIN_USER=admin
ADMIN_PASS=UnuRaymi2025!
