# =============================================================================
# Unu Raymi Monorepo - Hostinger Web Business Master Router & Security
# =============================================================================

DirectoryIndex frontend/index.php index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Block direct public HTTP access to database files
    RewriteRule ^database(/.*)?$ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.github - [F,L]

    # 2. Allow existing physical files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Admin Module Routing (admin PHP/HTML)
    RewriteRule ^admin/?$ admin/index.php [L,QSA]
    RewriteRule ^admin/(.*)$ admin/$1 [L,QSA]

    # 4. API Web App Module Routing (RESTful API)
    RewriteRule ^api/?$ api/index.php [L,QSA]
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]

    # 5. Frontend Module Routing (frontend PHP/HTML)
    RewriteRule ^$ frontend/index.php [L,QSA]
    RewriteRule ^index(\.html|\.php)?$ frontend/index.php [L,QSA]
    RewriteRule ^tours/?$ frontend/tours.php [L,QSA]
    RewriteRule ^tour/([^/]+)/?$ frontend/tour.php?slug=$1 [L,QSA]
    RewriteRule ^destinations/?$ frontend/destinations.php [L,QSA]
    RewriteRule ^destinations?/(peru|chile|bolivia|ecuador|colombia|argentina)/?$ frontend/country.php?country=$1 [L,QSA]
    RewriteRule ^destinations?/([^/]+)/?$ frontend/destination.php?slug=$1 [L,QSA]
    RewriteRule ^destination/([^/]+)/?$ frontend/destination.php?slug=$1 [L,QSA]
    RewriteRule ^(contact|contact-us|custom-journey|plan-your-trip)/?$ frontend/contact.php [L,QSA]
    RewriteRule ^(about|about-us|the-unu-raymi-difference)/?$ frontend/about.php [L,QSA]
    RewriteRule ^responsible-travel/?$ frontend/responsible-travel.php [L,QSA]

    # 6. Fallback for static assets in frontend/ (css, js, images)
    RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -f
    RewriteRule ^(.*)$ frontend/$1 [L]
</IfModule>
