# Unu Raymi Admin - Security & Routing (.htaccess)
DirectoryIndex index.php login.php

# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # Direct existing files
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URLs for admin if requested without .php
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^tours/?$ tours.php [L,QSA]
    RewriteRule ^destinations/?$ destinations.php [L,QSA]
    RewriteRule ^leads/?$ leads.php [L,QSA]
    RewriteRule ^settings/?$ settings.php [L,QSA]
</IfModule>

# Security: Deny direct access to sensitive extensions
<FilesMatch "\.(json|sql|log|env|git|md)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
